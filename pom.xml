<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.dream</groupId>
    <artifactId>basketball</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>basketball</name>
    <description>Demo project for Spring Boot</description>
    <properties>
        <java.version>17</java.version>
        <!--
          Spring Boot 2.7's dependency management pins kotlin-stdlib to 1.6.21, and that
          version silently wins over what com.interaso:webpush asks for. The library is
          compiled against Kotlin 1.9: its enums' static initialisers call
          kotlin.enums.EnumEntriesKt.enumEntries, which does not exist before 1.9. Since
          WebPushService.send returns one of those enums, the class loads on the first
          send and dies with NoClassDefFoundError — at runtime, in production, never at
          build time. Overriding the property is the supported way to lift it.
        -->
        <kotlin.version>1.9.25</kotlin.version>
    </properties>
    <dependencies>
        <!-- P4-1: removed spring-boot-starter-freemarker — backend is now a pure JSON API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Private messaging: STOMP over WebSocket push (P5) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!--
          Web Push (RFC 8291 payload encryption + RFC 8292 VAPID). Chosen over the more
          widely used nl.martijndwars:web-push because that one drags in async-http-client
          (Netty), jose4j, jcommander and BouncyCastle; this one is pure JDK crypto plus
          java.net.http and brings only kotlin-stdlib. Bytecode targets Java 11.
        -->
        <dependency>
            <groupId>com.interaso</groupId>
            <artifactId>webpush</artifactId>
            <version>1.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--redis-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Sessions stored in Redis: survive app restarts/redeploys; long sliding TTL instead of in-memory 30min -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <!--elasticsearch-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
        </dependency>
        <!--rabbitmq-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!--log-->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.25</version>
        </dependency>
        <!--mysql驱动-->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.26</version>
        </dependency>
        <!--mybatis-plus-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>3.3.2</version>
        </dependency>
        <!--MD5加密 对铭文信息进行加密操作-->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>

        <!--分页插件-->
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper</artifactId>
            <version>5.3.0</version>
        </dependency>
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper-spring-boot-autoconfigure</artifactId>
            <version>1.4.1</version>
        </dependency>
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper-spring-boot-starter</artifactId>
            <version>1.4.1</version>
        </dependency>
        <!-- freemarker热启动 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <!--lombok-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-commons</artifactId>
        </dependency>
        <!-- 验证码 -->
        <dependency>
            <groupId>com.github.whvcse</groupId>
            <artifactId>easy-captcha</artifactId>
            <version>1.6.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.7</version>
        </dependency>
        <!-- fastjson2（v1 兼容包：保留 com.alibaba.fastjson.* 包名，底层走 fastjson2） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>2.0.62</version>
        </dependency>
        <!-- P2-3: BCrypt password hashing only — crypto module, NOT the Spring Security starter
             (the starter would auto-configure a security filter chain we don't want yet) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- hutool -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.12</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.14.1</version>
        </dependency>
        <!--
          AWS SDK v2, S3 only. Uploads live in S3 from phase 1a on (see the vault doc
          07-云迁移/63). The `s3` artifact already contains S3Presigner, so there is no
          separate presigner dependency to add.

          BOTH bundled HTTP clients are excluded and replaced with url-connection-client,
          which is a thin wrapper over the JDK's HttpURLConnection and drags in nothing.

          netty-nio-client is only used by the ASYNC client, which we never construct.

          apache5-client is the harder story, and it took the site down once. It needs
          Apache HttpClient 5.4+ (for TlsSocketStrategy), but Spring Boot 2.7.6's
          dependency management pins httpclient5 to 5.1.4 and wins, so the class is simply
          absent. Nothing fails at build time: the app starts, reaches the point where the
          S3 client is first constructed, and dies with NoClassDefFoundError. This is the
          same shape as the kotlin-stdlib problem described in the properties block above.

          Mind the artifact id: this SDK ships apache5-client (package …http.apache5), NOT
          the older apache-client. Excluding the wrong name does nothing at all — Maven
          ignores an exclusion that matches no artifact, without a warning — which is how
          the first attempt at this fix silently failed.

          Overriding httpclient5.version would also work — nothing else in the tree uses
          httpclient5 — but that is managing the conflict rather than removing it, and it
          would have to stay correct across future Boot upgrades. url-connection-client has
          no version relationship with anything. Its limitations (no HTTP PATCH, no real
          connection pooling) do not apply: S3 never sends PATCH, and an upload is a handful
          of requests.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>2.51.3</version>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <version>2.51.3</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- freemarker热启动 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <fork>true</fork>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>
