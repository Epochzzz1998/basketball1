# Copy this file to `.env` (gitignored) and fill in real values, or set the same
# names as real environment variables. They feed the ${...} placeholders in
# application-ubuntu.yml and application-local.yml.
#
# How each environment consumes them:
#   • Server (ubuntu profile): docker-compose loads dream-app/.env and injects it
#     into the container through `env_file:`, and Spring resolves the placeholders.
#   • Local dev (local profile): set them in your IDE run configuration, or export
#     them in the shell first. Spring Boot does not read .env files by itself.
#
# Give each datastore its own password. Sharing one string across MySQL, Redis and
# RabbitMQ means a single exposure costs you all three at once.
#
# For local development the values in docker-compose.dev.yml are already set to
# `devpassword`, so the first four lines below work as they are.

# ── Required ────────────────────────────────────────────────────────────────
# MySQL
DB_USERNAME=epoch
DB_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USERNAME=epoch
RABBITMQ_PASSWORD=change-me

# ── Optional ────────────────────────────────────────────────────────────────
# Browser push. Generate a VAPID key pair once (for example with `web-push
# generate-vapid-keys`). Leave both empty and push is simply disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Firebase service account JSON, base64 encoded. Only needed for push to the
# packaged mobile app.
FCM_SERVICE_ACCOUNT_B64=

# Riot Games API key, for the League of Legends match history module.
RIOT_API_KEY=

# Uploaded files. `local` keeps them on disk, which is the default and needs
# nothing below. `dual` writes to disk and S3, `s3` reads from S3 as well.
UPLOAD_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
